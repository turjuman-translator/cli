{
  "name": "turjuman",
  "version": "0.1.0",
  "description": "Live captions + translation for mosque screens, OBS and browsers (Soniox)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "bin": {
    "turjuman": "dist/main.js",
    "captions": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts run --dev",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "tsx scripts/build-web.ts",
    "captions": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "pnpm typecheck && pnpm lint && vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:caption": "tsx test/e2e/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dom-tests.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "turjuman": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
