{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "vitest.e2e.config.ts"],
  // Unit tests of browser code: tsconfig.dom-tests.json (with the DOM library).
  "exclude": [
    "test/unit/web-*.ts",
    "test/unit/builder-*.ts",
    "test/unit/site-client-*.ts",
    "test/unit/*-dom.test.ts",
    "test/unit/helpers/web-*.ts",
    "test/unit/helpers/builder-*.ts",
    "test/unit/helpers/site-client-*.ts"
  ]
}
