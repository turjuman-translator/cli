# Your Soniox key: `turjuman setup` (Docker: `make keys`) checks it and saves it in the config
# folder's .env; you can also add it in the app under Keys. To set it here instead, remove the #
# and fill it in. A key set here wins.
# SONIOX_API_KEY=
# Optional: the key that encrypts API keys stored in orgs.yaml (32 random bytes, base64:
# openssl rand -base64 32). Unset: CONFIG_DIR/master.key is created on first use (mode 600).
TURJUMAN_MASTER_KEY=

# Nothing else is needed: the server makes config/config.yaml and the admin token
# (config/admin.token) on its first start, and downloads the Quran data by itself.

# Optional, Docker only: where the app's ports are published. 0.0.0.0 puts them on the LAN
# (needs server.exposure: lan in config/config.yaml).
# CAPTIONS_BIND=127.0.0.1

# Optional, Docker only: run several Turjuman instances on one computer, each from its own
# checkout. Give each its own name, ports and image tags (defaults below).
# COMPOSE_PROJECT_NAME=turjuman
# HTTP_PORT=8765
# HTTPS_PORT=8443
# BRIDGE_PORT=7000
# CAPTIONS_IMAGE=turjuman:local
# CAPTIONS_BUILD_IMAGE=turjuman:build

# Optional, Docker only: the time zone of session folders and log times.
# TZ=Europe/Amsterdam
